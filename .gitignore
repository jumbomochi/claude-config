# gstack installs itself as a full git clone here (1GB+ with node_modules).
# setup.sh checks it out at the commit in gstack.lock; its ./setup then
# generates the per-skill wrapper dirs listed in the block at the bottom.
skills/gstack/

# Skills Claude Code syncs from claude.ai (account-managed, rewritten by the app).
skills/synced/

# Private skills: this repo is public, keep personal details out.
skills/start-work/

